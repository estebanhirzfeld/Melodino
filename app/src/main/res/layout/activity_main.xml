<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackgroundDark"
    android:padding="16dp"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="16dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="16dp" />

    <TextView
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Can you guess the song?"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/answer_1_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/answer_1_text"
        style="@style/AnswerTextViewStyle"
        android:layout_marginHorizontal="12dp"
        android:text="[ . . . ]"
        app:layout_constraintBottom_toTopOf="@+id/answer_2_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/answer_2_text"
        style="@style/AnswerTextViewStyle"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="12dp"
        android:text="[ . . . ]"
        app:layout_constraintBottom_toTopOf="@+id/answer_3_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/answer_1_text" />

    <TextView
        android:id="@+id/answer_3_text"
        style="@style/AnswerTextViewStyle"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="12dp"
        android:text="[ . . . ]"
        app:layout_constraintBottom_toTopOf="@+id/answer_4_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/answer_2_text" />

    <TextView
        android:id="@+id/answer_4_text"
        style="@style/AnswerTextViewStyle"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="12dp"
        android:text="[ . . . ]"
        app:layout_constraintBottom_toTopOf="@+id/answer_5_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/answer_3_text" />

    <TextView
        android:id="@+id/answer_5_text"
        style="@style/AnswerTextViewStyle"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="12dp"
        android:text="[ . . . ]"
        app:layout_constraintBottom_toTopOf="@+id/play_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/answer_4_text" />

    <LinearLayout
        android:id="@+id/progress_info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginHorizontal="16dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/answer_5_text">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/time_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:01 / 0:30"
                android:textColor="@color/white50"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/points_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ 5pts"
                android:textColor="@color/white50"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:background="@drawable/progress_bar_background">

            <View
                android:id="@+id/progress_bar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/progress_bar_foreground" />
        </FrameLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/play_button"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/play_button_background"
        android:contentDescription="Play audio"
        android:elevation="4dp"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_play"
        app:layout_constraintBottom_toTopOf="@+id/play_instruction_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progress_info_container" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/skip_button"
        android:layout_width="72dp"
        android:layout_height="30dp"
        android:layout_marginEnd="48dp"
        android:background="@drawable/pill_white_background"
        android:paddingHorizontal="12dp"
        android:text="Skip"
        android:textAllCaps="false"
        android:textColor="@android:color/black"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/play_button"
        app:layout_constraintEnd_toStartOf="@+id/play_button"
        app:layout_constraintTop_toTopOf="@+id/play_button" />

    <TextView
        android:id="@+id/play_instruction_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="24dp"
        android:text="Turn up the volume and tap to start the track!"
        android:textAlignment="center"
        android:textColor="@color/white50"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@+id/answer_input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/play_button"
        app:layout_constraintVertical_bias="0.0" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/suggestions_recycler_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:background="@drawable/rounded_white_background"
        android:elevation="10dp"
        android:translationZ="10dp"
        android:visibility="gone"
        app:layout_constrainedHeight="true"
        app:layout_constraintHeight_max="250dp"
        app:layout_constraintBottom_toTopOf="@+id/answer_input"
        app:layout_constraintEnd_toEndOf="@+id/submit_button"
        app:layout_constraintStart_toStartOf="@+id/answer_input"
        tools:itemCount="3"
        tools:listitem="@layout/item_suggestion"
        tools:visibility="visible" />

    <EditText
        android:id="@+id/answer_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/edittext_background_selector"
        android:elevation="4dp"
        android:hint="Type your answer here..."
        android:inputType="text"
        android:padding="16dp"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textColorHint="@color/white50"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/submit_button"
        app:layout_constraintStart_toStartOf="@+id/guideline_start" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/submit_button"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:background="@drawable/submit_button_background"
        android:elevation="4dp"
        android:paddingHorizontal="24dp"
        android:text="SUBMIT"
        android:textColor="@color/colorBackgroundDark"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/answer_input"
        app:layout_constraintEnd_toEndOf="@+id/guideline_end"
        app:layout_constraintTop_toTopOf="@+id/answer_input" />

</androidx.constraintlayout.widget.ConstraintLayout>