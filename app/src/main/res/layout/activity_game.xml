<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackgroundDark"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="20dp">

    <View
        android:id="@+id/spotlight"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.6"
        android:background="@drawable/spotlight_gradient"
        app:layout_constraintBottom_toBottomOf="@+id/visualizer_view"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/visualizer_view"
        app:layout_constraintWidth_percent="1.2" />

    <!-- Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/hearts_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/heart1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_heart"
                app:tint="#ef4444" />

            <ImageView
                android:id="@+id/heart2"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="5dp"
                android:src="@drawable/ic_heart"
                app:tint="#ef4444" />

            <ImageView
                android:id="@+id/heart3"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="5dp"
                android:src="@drawable/ic_heart"
                app:tint="#ef4444" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Melodino"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.02"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/help_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_circle_border"
            android:gravity="center"
            android:text="?"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Playlist Info -->
    <TextView
        android:id="@+id/playlist_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Playlist: Loading..."
        android:textColor="#80FFFFFF"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Song Counter -->
    <TextView
        android:id="@+id/song_counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Song 1/5"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/playlist_info"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Visualizer -->
    <com.example.melodino.ui.VisualizerView
        android:id="@+id/visualizer_view"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="60dp"
        app:layout_constraintTop_toBottomOf="@id/song_counter"
        app:layout_constraintBottom_toTopOf="@id/controls_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Controls -->
    <LinearLayout
        android:id="@+id/controls_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/guess_input">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_skip"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingVertical="12dp"
            android:paddingHorizontal="24dp"
            android:text="Skip Song"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="50dp"
            app:strokeColor="#33FFFFFF"
            app:strokeWidth="2dp" />

        <ImageButton
            android:id="@+id/btn_play"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/bg_circle_white"
            android:src="@drawable/ic_play_arrow"
            android:padding="25dp"
            android:scaleType="fitCenter"
            app:tint="#0f172a" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_x2"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingVertical="12dp"
            android:paddingHorizontal="24dp"
            android:text="x2 Points"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="50dp"
            app:strokeColor="#33FFFFFF"
            app:strokeWidth="2dp" />
    </LinearLayout>

    <!-- Input -->
    <LinearLayout
        android:id="@+id/btn_time_increment"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_time_increment"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:elevation="8dp"
        app:layout_constraintBottom_toTopOf="@+id/controls_layout"
        app:layout_constraintEnd_toEndOf="@+id/controls_layout"
        app:layout_constraintHorizontal_bias="0.9">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_update"
            app:tint="#1e293b" />

        <TextView
            android:id="@+id/tv_increment_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TAP"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#1e293b" />
    </LinearLayout>

    <EditText
        android:id="@+id/guess_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_input_dark"
        android:hint="Type your guess here..."
        android:textColorHint="#94a3b8"
        android:textColor="@color/white"
        android:padding="18dp"
        android:gravity="center"
        android:inputType="textNoSuggestions"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/btn_submit" />

    <!-- Suggestions RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/suggestions_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_suggestions_white"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintBottom_toTopOf="@id/guess_input"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Submit Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_submit"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:backgroundTint="@color/colorPrimary"
        android:text="SUBMIT"
        android:textColor="@color/colorBackgroundDark"
        android:textSize="18sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>